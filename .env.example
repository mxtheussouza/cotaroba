# Credenciais de desenvolvimento local, sem dados reais. Nao usar em producao.
POSTGRES_USER=cotaroba
POSTGRES_PASSWORD=cotaroba_local
POSTGRES_DB=cotaroba
POSTGRES_PORT=5433

DATABASE_URL="postgresql://cotaroba:cotaroba_local@127.0.0.1:5433/cotaroba"
# Banco separado, criado e migrado conforme o README. Testes exigem host local e sufixo _test.
TEST_DATABASE_URL="postgresql://cotaroba:cotaroba_local@127.0.0.1:5433/cotaroba_test"

# Origem exata da aplicacao. Usar HTTPS fora do ambiente local.
BETTER_AUTH_URL="http://localhost:3000"
# Gere um segredo privado: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
